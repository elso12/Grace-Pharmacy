# Backend Environment Variables (Render)
# Add these to your Render web service environment variables

# Port for the server (Render sets this automatically, but good to have)
PORT=5000

# MongoDB connection string (e.g., from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pharmflow?retryWrites=true&w=majority

# Secret key for JWT signing
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS (e.g., your Vercel deployment URL)
# Example: https://pharmflow-frontend.vercel.app
CLIENT_URL=http://localhost:5173
